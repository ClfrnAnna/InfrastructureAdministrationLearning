Invoke-RestMethod -Uri http://localhost:8000/order/create -Method POST -Body "Test order 1"
Invoke-RestMethod -Uri http://localhost:8000/order/create -Method POST -Body "An important order marked urgent"
Invoke-RestMethod -Uri http://localhost:8000/order/create -Method POST -Body "Standart order"

Invoke-RestMethod -Uri http://localhost:8000/order/123
Invoke-RestMethod -Uri http://localhost:8000/order/456

# Остановить RabbitMQ
docker stop rabbitmq-container

# Попытаться создать заказ (должен вернуть 503)
Invoke-RestMethod -Uri http://localhost:8000/order/create -Method POST -Body "Ошибка" -ErrorAction SilentlyContinue

# Запустить RabbitMQ обратно
docker start rabbitmq-container