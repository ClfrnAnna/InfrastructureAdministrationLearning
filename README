Invoke-RestMethod -Uri "http://localhost:8001/get-message"
docker start rabbitmq-container
Invoke-RestMethod -Uri "http://localhost:8001/send-message" -Method Post -ContentType "application/json" -Body '{"message": "RabbitMQ is back"}'


