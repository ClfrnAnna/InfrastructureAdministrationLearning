Testing reservation
Cmd:
curl http://localhost:8001/queue-status
curl -X POST http://localhost:8001/send-message -d "Hello World"
curl http://localhost:8001/get-message
curl http://localhost:8001/healthy
docker stop rabbitmq-container
curl -X POST http://localhost:8001/send-message -d "RabbitMQ is down"
curl http://localhost:8001/get-message
docker start rabbitmq-container
curl -X POST http://localhost:8001/send-message -d "RabbitMQ is back"

