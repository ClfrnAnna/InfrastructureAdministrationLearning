Starting:
docker network create app1-network
docker network create app2-network
docker network create  logging-network
docker network create  postgres-cluster
docker network create  rabbitmq-network

docker-compose -f docker-compose-infra.yml up -d --build
docker-compose -f docker-compose-services.yml up -d --build
or
docker-compose -f docker-compose-infra.yml -f docker-compose-services.yml up -d 
or
docker-compose -f docker-compose-infra.yml up -d
Start-Sleep -Seconds 15
docker-compose -f docker-compose-services.yml up -d


Testing:

1. Создание заказов (POST) powershell
# Создать первый заказ
$resp1 = Invoke-RestMethod -Uri http://localhost:8000/order/create -Method POST -Body "Test 1"
$order1 = $resp1.order_id
Write-Host "Order 1 ID: $order1"

# Создать второй заказ
$resp2 = Invoke-RestMethod -Uri http://localhost:8000/order/create -Method POST -Body "Test 2"
$order2 = $resp2.order_id
Write-Host "Order 2 ID: $order2"

# Создать третий заказ
$resp3 = Invoke-RestMethod -Uri http://localhost:8000/order/create -Method POST -Body "Test 3"
$order3 = $resp3.order_id
Write-Host "Order 3 ID: $order3"

# (Опционально)
$respU = Invoke-RestMethod -Uri http://localhost:8000/order/create -Method POST -Body "An important urgent order"
$orderU = $respU.order_id
Write-Host "Urgent order ID: $orderU"


or 

1..10 | ForEach-Object {
    $resp = Invoke-RestMethod -Uri http://localhost:8000/order/create -Method POST -Body "Auto order $_"
    Write-Host "Created order: $($resp.order_id)"
    Start-Sleep -Milliseconds 500
}

2. Получение статусов заказов (GET) с разной частотой
powershell
# Получить заказ 1 (один раз)
Invoke-RestMethod -Uri "http://localhost:8000/order/$order1"

# Получить заказ 2 (три раза – для увеличения счётчика просмотров)
Invoke-RestMethod -Uri "http://localhost:8000/order/$order2"
Start-Sleep -Seconds 1
Invoke-RestMethod -Uri "http://localhost:8000/order/$order2"
Start-Sleep -Seconds 1
Invoke-RestMethod -Uri "http://localhost:8000/order/$order2"

# Получить заказ 3 (два раза)
Invoke-RestMethod -Uri "http://localhost:8000/order/$order3"
Start-Sleep -Seconds 1
Invoke-RestMethod -Uri "http://localhost:8000/order/$order3"

# Получить "urgent" заказ (один раз)
Invoke-RestMethod -Uri "http://localhost:8000/order/$orderU"
