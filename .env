APP_VERSION=v6.0.0
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEBUG=false

# PostgreSQL (общие учётные данные)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ORDERS_DB_HOST=api-gateway
ORDERS_DB_READ_PORT=5433
ORDERS_DB_WRITE_PORT=5432
ORDERS_DB_NAME=orders_db
ORDERS_DB_USER=postgres
ORDERS_DB_PASSWORD=postgres

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=order-logs

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123
RMQ_HOST=rabbitmq
RMQ_USER=admin
RMQ_PASSWORD=admin123
RABBITMQ_QUEUE=orders_queue

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=admin123
REDIS_QUEUE=my_redis_queue