APP_VERSION=v6.0.0
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEBUG=false

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_PASSWORD=admin123

# ZooKeeper
ZOOKEEPER_CLIENT_PORT=2181

# MinIO root-учётка
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123

# PostgreSQL
PGDATA=/var/lib/postgresql/data/pgdata

# FastAPI
PROCESSOR_URL=http://api-gateway:8001

# Healthchecker
APP1_URL=http://fastapi-app1:8000/healthy
APP2_URL=http://fastapi-app2:8000/healthy
CHECK_INTERVAL=60

# init-db / order-processor
ORDERS_DB_HOST=haproxy
ORDERS_DB_PORT=5432
ORDERS_DB_NAME=orders_db
ORDERS_DB_USER=postgres
ORDERS_DB_PASSWORD=postgres

# RabbitMQ
RMQ_HOST=rabbitmq
RMQ_USER=admin
RMQ_PASSWORD=admin123
RABBITMQ_QUEUE=orders_queue

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_QUEUE=my_redis_queue
REDIS_CACHE_TTL=60
REDIS_CACHE_TIME=60

# MinIO (для order-processor и init-minio)
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=order-logs
