APP_VERSION=v6.0.0
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEBUG=false

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ORDERS_DB_HOST=api-gateway
ORDERS_DB_READ_PORT=5433
ORDERS_DB_WRITE_PORT=5432
ORDERS_DB_NAME=orders_db
ORDERS_DB_USER=postgres
ORDERS_DB_PASSWORD=postgres

# ZooKeeper
ZOOKEEPER_CLIENT_PORT=2181

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=order-logs

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123
RMQ_HOST=rabbitmq
RMQ_USER=admin
RMQ_PASSWORD=admin123
RABBITMQ_QUEUE=orders_queue

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=admin123
REDIS_QUEUE=my_redis_queue
REDIS_CACHE_TTL=60
REDIS_CACHE_TIME=60

# FastAPI
PROCESSOR_URL=http://order-processor:8000

# Healthchecker
APP1_URL=http://fastapi-app1:8000
APP2_URL=http://fastapi-app2:8000
CHECK_INTERVAL=60

# PostgreSQL data dir
PGDATA=/var/lib/postgresql/data/pgdata